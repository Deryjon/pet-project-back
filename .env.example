PORT=3001
# Public origin this API is reachable at. Required in production —
# used to build absolute URLs for uploaded files (e.g. product photos).
# Without it, uploaded file URLs fall back to http://localhost:$PORT,
# which is unreachable for real users.
APP_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:5173"
# Comma-separated list of EXTRA origins allowed for CORS, on top of FRONTEND_URL
# (and instead of the built-in localhost defaults, once FRONTEND_URL is set).
# Example: allow a local frontend dev server to call a deployed backend:
# CORS_ORIGINS="http://localhost:3000"
CORS_ORIGINS=""
DATABASE_URL="postgresql://postgres:1234@localhost:5432/crm_db"
JWT_SECRET="super_secret_key"
OPENAI_API_KEY=""
OPENAI_INVOICE_MODEL="gpt-5.4-nano"
INVOICE_RECOGNITION_PROVIDER="paddle"
PADDLE_OCR_PYTHON=".venv-ocr/bin/python"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="super_refresh_secret_key"
JWT_REFRESH_EXPIRES_IN="30d"
