generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  platform
  company
}

model Company {
  id        String   @id @default(uuid())
  login     String   @unique
  name      String
  subdomain String   @unique
  isActive  Boolean  @default(true)
  shops     Shop[]
  roles     CompanyRole[]
  users     User[]
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyRole {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Shop {
  id          String           @id @default(uuid())
  companyId   String
  name        String
  branchCode  String
  isActive    Boolean          @default(true)
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currentUsers User[]          @relation("CurrentShop")
  userAccesses UserShopAccess[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([companyId, branchCode])
}

model User {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  birthDate   DateTime?
  phoneNumber String
  password    String
  userType    UserType @default(company)
  role        String
  companyId   String?
  crmRoleId   String?
  branchCode  String?
  currentShopId String?
  canSwitchShops Boolean @default(false)
  avatarUrl   String?
  language    String   @default("ru")
  theme       String   @default("auto")
  isActive    Boolean  @default(true)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  crmRole     Role?    @relation(fields: [crmRoleId], references: [id], onDelete: SetNull)
  currentShop Shop?    @relation("CurrentShop", fields: [currentShopId], references: [id], onDelete: SetNull)
  shopAccesses UserShopAccess[]
  sales       Sale[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, phoneNumber])
}

model UserShopAccess {
  id        Int      @id @default(autoincrement())
  userId    Int
  shopId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, shopId])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Supplier {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  products  ProductSupplier[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Product {
  id             Int               @id @default(autoincrement())
  photo          String?
  name           String
  sku            String?           @unique
  barcode        String?           @unique
  productType    String?
  variantType    String?
  unit           String?
  purchasePrice  Float?
  markupPercent  Float?
  salePrice      Float?
  discountPrice  Float?
  quantity       Int               @default(0)
  metadata       Json?
  categoryId     Int?
  brandId        Int?
  category       Category?         @relation(fields: [categoryId], references: [id])
  brand          Brand?            @relation(fields: [brandId], references: [id])
  suppliers      ProductSupplier[]
  stocks         ProductStock[]
  saleItems      SaleItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model ProductSupplier {
  productId   Int
  supplierId  Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([productId, supplierId])
}

model ProductStock {
  id            Int      @id @default(autoincrement())
  productId     Int
  branchCode    String
  quantity      Int      @default(0)
  purchasePrice Float?
  salePrice     Float?
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Sale {
  id              Int        @id @default(autoincrement())
  number          String     @unique
  status          String     @default("draft")
  discountPercent Float      @default(0)
  discountAmount  Float      @default(0)
  payableTotal    Float      @default(0)
  total           Float      @default(0)
  paymentMethod   String?
  clientName      String?
  branchCode      String?
  isDraft         Boolean    @default(true)
  userId          Int?
  user            User?      @relation(fields: [userId], references: [id])
  items           SaleItem[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  paidAt          DateTime?
}

model SaleItem {
  id         Int      @id @default(autoincrement())
  saleId      Int
  productId   Int?
  name        String
  barcode     String?
  sku         String?
  quantity    Int
  salePrice   Float
  lineTotal   Float
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id           String           @id @default(uuid())
  companyId    String
  name         String
  description  String           @default("")
  externalId   Int              @unique
  clientTypeId String           @default("")
  sessionId    String           @default("")
  isAdmin      Boolean          @default(false)
  type         Int              @default(0)
  deletedAt    Int              @default(0)
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([companyId, name])
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       String
  permissionId String
  isActive     Boolean  @default(false)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([roleId, permissionId])
}
