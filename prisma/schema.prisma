generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  platform
  company
}

enum OrderStatus {
  DRAFT
  COMPLETED
  CANCELLED
  PARKED
  RETURNED
}

enum OrderType {
  SALE
  RETURN
}

enum StockMovementType {
  SALE
  RETURN
  WRITE_OFF
  PURCHASE
  TRANSFER
  ADJUSTMENT
}

enum TransferStatus {
  DRAFT
  SENT
  ACCEPTED
  CANCELLED
}

enum SalaryCalculationType {
  FIXED_ONLY
  PROFIT_PERCENT_ONLY
  REVENUE_PERCENT_ONLY
  FIXED_PLUS_PROFIT
  FIXED_PLUS_REVENUE
}

enum ClientGender {
  male
  female
  unknown
}

enum ClientDebtStatus {
  paid
  partial
  unpaid
}

enum ClientCardType {
  local
  loyalty
  discount
  bonus
}

enum ProductTier {
  BUDGET
  MID
  PREMIUM
}

model Company {
  id                 String              @id @default(uuid())
  login              String              @unique
  name               String
  subdomain          String              @unique
  ownerName          String?
  ownerPhone         String?
  ownerEmail         String?
  status             String              @default("active")
  blockReason        String?
  isActive           Boolean             @default(true)
  shops              Shop[]
  products           Product[]
  categories         Category[]
  brands             Brand[]
  suppliers          Supplier[]
  roles              CompanyRole[]
  users              User[]
  crmRoles           Role[]
  sales              Sale[]
  cashboxes          Cashbox[]
  paymentTypes       PaymentType[]
  companyPaymentTypes CompanyPaymentType[]
  companyProfile     CompanyProfileSetting?
  companyTariff      CompanyTariffSetting?
  companyCurrency    CompanyCurrencySetting?
  loyaltyProgram     LoyaltyProgramSetting?
  measurementUnits   MeasurementUnitSetting[]
  priceTags          PriceTagSetting[]
  receipts           Receipt[]
  chequeSettings     ChequeSettings[]
  orders             Order[]
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  subscriptions      Subscription[]
  payments           Payment[]
  platformActionLogs PlatformActionLog[]
  clients            Client[]
  clientGroups       ClientGroup[]
  clientTags         ClientTag[]
  clientNotes        ClientNote[]
  clientDebts        ClientDebt[]
  transfers          Transfer[]
  clientDebtRepayments ClientDebtRepayment[]
  clientCards        ClientCard[]
  inventorySessions  InventorySession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
}

model CompanyRole {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Shop {
  id             String           @id @default(uuid())
  companyId      String
  name           String
  branchCode     String
  address        String?
  phoneNumbers   Json?
  facebook       String?
  instagram      String?
  telegram       String?
  website        String?
  workingHours   Json?
  isActive       Boolean          @default(true)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currentUsers   User[]           @relation("CurrentShop")
  userAccesses   UserShopAccess[]
  cashboxes      Cashbox[]
  orders         Order[]
  registeredClients Client[]           @relation("ClientRegistrationShop")
  clientDebts    ClientDebt[]
  stockMovements StockMovement[]
  supplyPriceHistory ProductSupplyPriceHistory[]
  departureTransfers Transfer[]        @relation("TransferDepartureShop")
  arrivalTransfers   Transfer[]        @relation("TransferArrivalShop")
  inventorySessions  InventorySession[]
  receipts       Receipt[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([companyId, branchCode])
}

model User {
  id                 Int                 @id @default(autoincrement())
  firstName          String
  lastName           String
  birthDate          DateTime?
  phoneNumber        String
  email              String?
  passwordHash       String
  userType           UserType            @default(company)
  platformRole       String?
  companyId          String?
  crmRoleId          String?
  branchCode         String?
  currentShopId      String?
  canSwitchShops     Boolean             @default(false)
  avatarUrl          String?
  language           String              @default("ru")
  theme              String              @default("auto")
  status             String              @default("active")
  isActive           Boolean             @default(true)
  deletedAt          Int                 @default(0)
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  crmRole            Role?               @relation(fields: [crmRoleId], references: [id], onDelete: SetNull)
  currentShop        Shop?               @relation("CurrentShop", fields: [currentShopId], references: [id], onDelete: SetNull)
  shopAccesses       UserShopAccess[]
  sales              Sale[]
  sellerSalarySettings SellerSalarySettings?
  soldSaleItems      SaleItem[]           @relation("SaleItemSeller")
  orders             Order[]
  stockMovements     StockMovement[]
  supplyPriceHistory ProductSupplyPriceHistory[]
  auditLogs          AuditLog[]
  createdPayments    Payment[]           @relation("PaymentCreatedBy")
  platformActionLogs PlatformActionLog[]
  clientNotes        ClientNote[]
  clientDebtRepayments ClientDebtRepayment[]
  createdTransfers   Transfer[]          @relation("TransferCreatedBy")
  acceptedTransfers  Transfer[]          @relation("TransferAcceptedBy")
  createdInventories InventorySession[]  @relation("InventoryCreatedBy")
  closedInventories  InventorySession[]  @relation("InventoryClosedBy")
  authSessions       AuthSession[]
  telegramSubscriber TelegramSubscriber?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([companyId, phoneNumber])
  @@index([status])
}

model AuthSession {
  id               String    @id
  userId           Int
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy       AuthSession? @relation("AuthSessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  previousSessions AuthSession[] @relation("AuthSessionReplacement")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  priceMonthly  Decimal        @db.Decimal(12, 2)
  maxShops      Int
  maxUsers      Int
  maxProducts   Int
  status        String         @default("active")
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

model Subscription {
  id        String    @id @default(uuid())
  companyId String
  planId    String
  status    String    @default("active")
  startDate DateTime
  endDate   DateTime
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId, status])
  @@index([status, endDate])
}

model Payment {
  id             String       @id @default(uuid())
  companyId      String
  subscriptionId String
  amount         Decimal      @db.Decimal(12, 2)
  method         String
  paidAt         DateTime     @default(now())
  periodStart    DateTime
  periodEnd      DateTime
  comment        String?
  createdById    Int?
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([companyId, paidAt])
  @@index([subscriptionId])
}

model PlatformActionLog {
  id          String   @id @default(uuid())
  adminId     Int?
  companyId   String?
  action      String
  description String?
  admin       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([companyId])
  @@index([createdAt])
}

model PlatformSetting {
  id        String   @id @default("default")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserShopAccess {
  id        Int      @id @default(autoincrement())
  userId    Int
  shopId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, shopId])
}

model Category {
  id        Int       @id @default(autoincrement())
  companyId String
  name      String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Brand {
  id        Int       @id @default(autoincrement())
  companyId String
  name      String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Supplier {
  id        Int               @id @default(autoincrement())
  companyId String
  name      String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  ProductSupplier[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model ProductImportSession {
  id            String @id
  jobId         String
  companyId     String
  shopId        String
  branchCode    String
  branchName    String?
  stocktakingId String?
  name          String
  mode          String
  status        String
  fields        Json
  rows          Json
  items         Json
  onMatchPolicy Json
  dryRunSummary Json?
  result        Json?
  createdAt     String
  updatedAt     String

  @@index([companyId, status])
  @@index([shopId])
  @@index([jobId])
}

model Product {
  id               Int               @id @default(autoincrement())
  publicId         String            @unique @default(uuid())
  companyId        String?
  photo            String?
  name             String
  sku              String?
  barcode          String?
  productType      String?
  variantType      String?
  unit             String?
  purchasePrice    Float?
  markupPercent    Float?
  salePrice        Float?
  discountPrice    Float?
  quantity         Float             @default(0)
  metadata         Json?
  categoryId       Int?
  brandId          Int?
  productGroupId   String?
  tier             ProductTier?
  archivedAt       DateTime?
  archivedByUserId Int?
  archivedByName   String?
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id])
  brand            Brand?            @relation(fields: [brandId], references: [id])
  suppliers        ProductSupplier[]
  stocks           ProductStock[]
  saleItems        SaleItem[]
  orderItems       OrderItem[]
  stockMovements   StockMovement[]
  supplyPriceHistory ProductSupplyPriceHistory[]
  transferItems    TransferItem[]
  inventoryItems   InventoryItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([companyId, productGroupId])
}

model Cashbox {
  id        String   @id @default(uuid())
  companyId String
  shopId    String
  name      String
  chequeId  String?
  ePos      Int      @default(0)
  webKassa  Int      @default(0)
  isActive  Boolean  @default(true)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([shopId])
}

model PaymentType {
  id        String         @id @default(uuid())
  companyId String
  name      String
  isCash    Boolean        @default(false)
  isActive  Boolean        @default(true)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments  OrderPayment[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model CompanyPaymentType {
  id                    String   @id @default(uuid())
  companyId             String
  name                  String
  token                 String   @default("")
  isEditable            Boolean  @default(true)
  dontShowInMakePayment Boolean  @default(false)
  dontShowInSettings    Boolean  @default(false)
  isCashPaymentType     Boolean  @default(false)
  paymentTypeId         String
  paymentTypeName       String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model CountryReference {
  id        String              @id
  name      String
  code      String              @unique
  timeZones TimeZoneReference[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model TimeZoneReference {
  id         String            @id
  countryId  String?
  name       String
  shortName  String
  gmtOffset  String
  country    CountryReference? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([countryId])
}

model CompanyProfileSetting {
  companyId  String   @id
  data       Json
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CompanyTariffSetting {
  companyId  String   @id
  data       Json
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CompanyCurrencySetting {
  id           String   @id @default(uuid())
  companyId    String   @unique
  currencyId   String
  name         String
  symbol       String
  isoCode      String
  exchangeRate Float    @default(1)
  precision    Int      @default(0)
  isEditable   Boolean  @default(false)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LoyaltyProgramSetting {
  id                 String   @id @default(uuid())
  companyId          String   @unique
  isActive           Boolean  @default(false)
  name               String   @default("")
  type               String   @default("")
  cashbackPercent    Float    @default(0)
  bonusPercent       Float    @default(0)
  levels             Json
  hasCustomerBalance Boolean  @default(false)
  hasCustomerDebt    Boolean  @default(false)
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MeasurementUnitSetting {
  id         String   @id
  companyId  String
  name       String
  shortName  String
  precision  String
  isEditable Boolean  @default(false)
  isDefault  Boolean  @default(false)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model PriceTagSetting {
  id            String   @id
  companyId     String
  name          String
  width         Float
  length        Float
  barcodeType   String
  barcodeTypeId String
  isDefault     Boolean  @default(false)
  properties    Json?
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

model Receipt {
  id             String    @id @default(uuid())
  saleId         Int       @unique
  companyId      String
  shopId         String?
  branchCode     String?
  number         String
  status         String    @default("CREATED") // CREATED | PRINTED | SENT
  managerName    String?
  managerPhone   String?
  sellerName     String?
  clientName     String?
  clientPhone    String?
  saleComment    String?
  cashbackEarned Float     @default(0)
  qrPayload      String?
  printedAt      DateTime?
  sentAt         DateTime?
  // snapshot fields — frozen at first print (sale completion), never recalculated
  // on reprint so a receipt printed today and reprinted in 6 months are identical
  // even if product prices/company payment-type config change later.
  items          Json?
  subtotal       Float     @default(0)
  discount       Float     @default(0)
  discountPercent Float    @default(0)
  totalDue       Float     @default(0)
  paidCash       Float     @default(0)
  paidCard       Float     @default(0)
  paidCashback   Float     @default(0)
  debt           Float     @default(0)
  // customer balance/debt breakdown — frozen at snapshot time same as the
  // money fields above, so a reprint never shows a balance/debt state that
  // no longer matches what the customer was told at sale time
  balanceBefore   Float    @default(0)
  balanceAdded    Float    @default(0)
  balanceDeducted Float    @default(0)
  balanceAfter    Float    @default(0)
  debtBefore      Float    @default(0)
  debtAdded       Float    @default(0)
  debtPaid        Float    @default(0)
  debtAfter       Float    @default(0)
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shop           Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@index([shopId])
  @@index([branchCode])
}

// A cheque template. A company can have any number of these (like Billz's
// /api/v1/cheque list, named and independently editable) but exactly one is
// isDefault=true at a time — that's the one used to render/print receipts.
// Which pieces of information appear on the cheque (and in what order) lives
// in `blocks` (see cheque-blocks.constant.ts) — a Billz-style ordered list of
// toggleable items grouped by block_type. The fields below are the handful of
// values that have no other natural home (everything else — shop name/
// address/phone/socials, legal name, INN — is resolved live from Shop /
// CompanyProfileSetting at render time).
model ChequeSettings {
  id                 String   @id @default(uuid())
  companyId          String
  name               String   @default("Стандартный")
  isDefault          Boolean  @default(false)
  hasInformationBlock Boolean @default(true)
  hasLowerBlock      Boolean  @default(true)
  // layout
  paperWidth         Int      @default(80)
  fontSize           Int      @default(13)
  dividerStyle       String   @default("single") // single | double | none
  dividerGap         Int      @default(8)
  sectionGap         Int      @default(12)
  itemDividers       Boolean  @default(false)
  // values with no other source
  hasLogo            Boolean  @default(false)
  logoUrl            String   @default("")
  hasAdditionalImage Boolean  @default(false)
  additionalImageUrl String   @default("")
  footerMessage      String   @default("")
  footerNote         String   @default("")
  qrCodeUrl          String   @default("")
  elementStyles      Json?    // [{id,label,fontSize,fontWeight,visible,order,marginBottom}]
  blocks             Json     // ChequeBlockDefinition[] — key, block_type, name, sequence_number, is_active
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
}

model Client {
  id                  String          @id @default(uuid())
  companyId           String
  code                String
  firstName           String
  lastName            String?
  middleName          String?
  phone               String
  gender              ClientGender    @default(unknown)
  birthDate           DateTime?       @db.Date
  maritalStatus       String?
  address             String?
  socialLinks         Json?
  relatives           Json?
  registrationShopId  String?
  registeredAt        DateTime        @default(now())
  balanceUzs          Decimal         @default(0) @db.Decimal(12, 2)
  debtUzs             Decimal         @default(0) @db.Decimal(12, 2)
  totalPurchasesUzs   Decimal         @default(0) @db.Decimal(12, 2)
  lastPurchaseAt      DateTime?
  visitsCount         Int             @default(0)
  smsNotifications    Boolean         @default(false)
  phoneNotifications  Boolean         @default(false)
  socialNotifications Boolean         @default(false)
  emailNotifications  Boolean         @default(false)
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  registrationShop    Shop?           @relation("ClientRegistrationShop", fields: [registrationShopId], references: [id], onDelete: SetNull)
  groups              ClientGroupLink[]
  tags                ClientTagLink[]
  notes               ClientNote[]
  debts               ClientDebt[]
  cards               ClientCard[]
  debtRepayments      ClientDebtRepayment[]
  orders              Order[]
  sales               Sale[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, phone])
  @@index([registrationShopId])
  @@index([registeredAt])
}

model ClientGroup {
  id        String            @id @default(uuid())
  companyId String
  name      String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients   ClientGroupLink[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model ClientGroupLink {
  clientId String
  groupId  String
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group    ClientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([clientId, groupId])
  @@index([groupId])
}

model ClientTag {
  id        String          @id @default(uuid())
  companyId String
  name      String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients   ClientTagLink[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model ClientTagLink {
  clientId String
  tagId    String
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      ClientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([clientId, tagId])
  @@index([tagId])
}

model ClientNote {
  id          String   @id @default(uuid())
  companyId   String
  clientId    String
  createdById Int?
  text        String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, clientId])
  @@index([createdById])
}

model ClientDebt {
  id                 String              @id @default(uuid())
  companyId          String
  clientId           String
  saleId             Int?
  shopId             String?
  amountUzs          Decimal             @db.Decimal(12, 2)
  remainingAmountUzs Decimal             @db.Decimal(12, 2)
  repaidAmountUzs    Decimal             @default(0) @db.Decimal(12, 2)
  dueDate            DateTime?           @db.Date
  status             ClientDebtStatus    @default(unpaid)
  comment            String?
  receiptUrl         String?
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sale               Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  shop               Shop?               @relation(fields: [shopId], references: [id], onDelete: SetNull)
  repayments         ClientDebtRepayment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([companyId, clientId])
  @@index([saleId])
  @@index([shopId])
  @@index([status])
}

model ClientDebtRepayment {
  id          String     @id @default(uuid())
  companyId   String
  clientId    String
  debtId      String
  createdById Int?
  amountUzs   Decimal    @db.Decimal(12, 2)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  debt        ClientDebt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([companyId, clientId])
  @@index([debtId])
  @@index([createdById])
}

model ClientCard {
  id        String         @id @default(uuid())
  companyId String
  clientId  String
  type      ClientCardType @default(local)
  number    String
  isActive  Boolean        @default(true)
  issuedAt  DateTime?
  expiresAt DateTime?
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([companyId, number])
  @@index([companyId, clientId])
}

model Order {
  id             String          @id @default(uuid())
  companyId      String
  shopId         String
  cashboxId      String?
  userId         Int
  orderNumber    String
  orderType      OrderType       @default(SALE)
  status         OrderStatus     @default(DRAFT)
  customerId     String?
  totalPrice     Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal         @default(0) @db.Decimal(12, 2)
  comment        String?
  versionNumber  Int             @default(1)
  completedAt    DateTime?
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashbox        Cashbox?        @relation(fields: [cashboxId], references: [id], onDelete: SetNull)
  user           User            @relation(fields: [userId], references: [id])
  customer       Client?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       OrderPayment[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([shopId])
  @@index([status])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      Int
  quantity       Decimal  @db.Decimal(12, 3)
  price          Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice     Decimal  @db.Decimal(12, 2)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([productId])
}

model OrderPayment {
  id            String      @id @default(uuid())
  orderId       String
  paymentTypeId String
  amount        Decimal     @db.Decimal(12, 2)
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentType   PaymentType @relation(fields: [paymentTypeId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([orderId])
  @@index([paymentTypeId])
}

model StockMovement {
  id             String            @id @default(uuid())
  companyId      String
  shopId         String
  productId      Int
  orderId        String?
  type           StockMovementType
  displayTypeCode String           @default("")
  displayTypeLabel String          @default("")
  externalId     String            @default("")
  quantity       Decimal           @db.Decimal(12, 3)
  loadedMeasurementValue Decimal   @default(0) @db.Decimal(12, 3)
  beforeQuantity Decimal           @db.Decimal(12, 3)
  afterQuantity  Decimal           @db.Decimal(12, 3)
  fromShopId     String            @default("")
  toShopId       String            @default("")
  supplyPrice    Decimal           @default(0) @db.Decimal(12, 2)
  retailPrice    Decimal           @default(0) @db.Decimal(12, 2)
  newRetailPrice Decimal           @default(0) @db.Decimal(12, 2)
  fromRetailPrice Decimal          @default(0) @db.Decimal(12, 2)
  fromSupplyPrice Decimal          @default(0) @db.Decimal(12, 2)
  createdById    Int
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id])
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy      User              @relation(fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())

  @@index([companyId])
  @@index([shopId])
  @@index([productId])
  @@index([orderId])
}

model ProductSupplyPriceHistory {
  id            String   @id @default(uuid())
  productId      Int
  shopId         String
  supplyPrice    Decimal  @db.Decimal(12, 2)
  supplyCurrency String   @default("")
  oldSupplyPrice Decimal  @default(0) @db.Decimal(12, 2)
  createdById    Int?
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
  @@index([shopId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    Int
  action    String
  entity    String
  entityId  String
  meta      Json?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
}

model ProductSupplier {
  productId  Int
  supplierId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, supplierId])
}

model ProductStock {
  id                 Int       @id @default(autoincrement())
  productId          Int
  branchCode         String
  quantity           Float     @default(0)
  purchasePrice      Float?
  salePrice          Float?
  lowStockNotifiedAt DateTime?
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model InventorySession {
  id            String              @id @default(uuid())
  companyId     String
  shopId        String
  name          String
  status        String              @default("draft")
  comment       String              @default("")
  createdById   Int
  closedById    Int?
  closedAt      DateTime?
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy     User                @relation("InventoryCreatedBy", fields: [createdById], references: [id])
  closedBy      User?               @relation("InventoryClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  items         InventoryItem[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([companyId, status])
  @@index([shopId])
}

model InventoryItem {
  id                String            @id @default(uuid())
  inventorySessionId String
  productId         Int
  expectedQuantity  Float             @default(0)
  actualQuantity    Float             @default(0)
  difference        Float             @default(0)
  session           InventorySession  @relation(fields: [inventorySessionId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id])
  createdAt         DateTime          @default(now())

  @@unique([inventorySessionId, productId])
  @@index([inventorySessionId])
  @@index([productId])
}

model Transfer {
  id                      String         @id @default(uuid())
  externalId              Int?           @unique
  companyId               String
  name                    String
  departureShopId         String
  arrivalShopId           String
  status                  TransferStatus @default(DRAFT)
  createdById             Int
  acceptedById            Int?
  comment                 String         @default("")
  useDepartureShopPrices  Boolean        @default(false)
  sentAt                  DateTime?
  acceptedAt              DateTime?
  company                 Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departureShop           Shop           @relation("TransferDepartureShop", fields: [departureShopId], references: [id], onDelete: Cascade)
  arrivalShop             Shop           @relation("TransferArrivalShop", fields: [arrivalShopId], references: [id], onDelete: Cascade)
  createdBy               User           @relation("TransferCreatedBy", fields: [createdById], references: [id])
  acceptedBy              User?          @relation("TransferAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  items                   TransferItem[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([companyId, createdAt])
  @@index([departureShopId])
  @@index([arrivalShopId])
  @@index([status])
}

model TransferItem {
  id              String    @id @default(uuid())
  transferId      String
  productId       Int
  quantity        Decimal   @db.Decimal(12, 3)
  arrivedQuantity Decimal   @default(0) @db.Decimal(12, 3)
  transfer        Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([transferId, productId])
  @@index([transferId])
  @@index([productId])
}

model Sale {
  id              Int        @id @default(autoincrement())
  companyId       String?
  number          String     @unique
  saleType        String     @default("sale")
  status          String     @default("draft")
  discountPercent Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal    @default(0) @db.Decimal(12, 2)
  payableTotal    Decimal    @default(0) @db.Decimal(12, 2)
  total           Decimal    @default(0) @db.Decimal(12, 2)
  paymentMethod   String?
  extraPayments   Json?
  clientId        String?
  clientName      String?
  parkNote        String?
  comment         String?
  branchCode      String?
  isDraft         Boolean    @default(true)
  userId          Int?
  parentSaleId    Int?
  company         Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  client          Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user            User?      @relation(fields: [userId], references: [id])
  parentSale      Sale?      @relation("SaleAdjustments", fields: [parentSaleId], references: [id], onDelete: SetNull)
  childSales      Sale[]     @relation("SaleAdjustments")
  clientDebts     ClientDebt[]
  items           SaleItem[]
  receipt         Receipt?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  paidAt          DateTime?

  @@index([companyId])
  @@index([createdAt])
  @@index([branchCode])
  @@index([clientId])
  @@index([userId])
  @@index([parentSaleId])
  @@index([saleType])
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    Int
  productId Int?
  sellerId  Int?
  name      String
  barcode   String?
  sku       String?
  quantity  Decimal  @db.Decimal(12, 3)
  salePrice Decimal  @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)
  retailPriceAtSale Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal    @default(0) @db.Decimal(12, 2)
  finalPrice        Decimal    @default(0) @db.Decimal(12, 2)
  supplyPriceAtSale Decimal    @default(0) @db.Decimal(12, 2)
  profitAtSale      Decimal    @default(0) @db.Decimal(12, 2)
  markupAtSale      Decimal?   @db.Decimal(12, 2)
  sellerBonusAmount Decimal    @default(0) @db.Decimal(12, 2)
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
  seller    User?    @relation("SaleItemSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([saleId])
  @@index([productId])
}

model SellerSalarySettings {
  id              String                @id @default(uuid())
  userId          Int                   @unique
  fixedSalary     Float                 @default(0)
  salaryPercent   Float                 @default(0)
  calculationType SalaryCalculationType @default(FIXED_PLUS_PROFIT)
  bonusEnabled    Boolean               @default(true)
  isActive        Boolean               @default(true)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model Role {
  id           String           @id @default(uuid())
  companyId    String
  name         String
  description  String           @default("")
  externalId   Int
  clientTypeId String           @default("")
  sessionId    String           @default("")
  isAdmin      Boolean          @default(false)
  type         Int              @default(0)
  deletedAt    Int              @default(0)
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, externalId])
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       String
  permissionId String
  isActive     Boolean  @default(false)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([roleId, permissionId])
}

model TelegramSubscriber {
  id             String   @id @default(uuid())
  chatId         String   @unique
  userId         Int      @unique
  companyId      String
  notifyOnSale   Boolean  @default(true)
  notifySellerAnalytics Boolean @default(false)
  notifyOnLogin  Boolean  @default(false)
  notifyOnLowStock Boolean @default(false)
  branchCode     String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAt       DateTime @default(now())

  @@index([companyId])
  @@index([companyId, notifyOnSale])
  @@index([companyId, notifySellerAnalytics])
  @@index([companyId, notifyOnLogin])
  @@index([companyId, notifyOnLowStock])
}

model TelegramLinkToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    Int
  companyId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}
